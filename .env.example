# --- DefectDojo core ---
DD_DEBUG=False
DD_DJANGO_METRICS_ENABLED=False
DD_ALLOWED_HOSTS=*
DD_SITE_URL=http://localhost:8080

# wygeneruj wlasne wartosci przed pierwszym uruchomieniem, np.:
#   openssl rand -base64 64 | tr -d '\n'   -> DD_SECRET_KEY
#   openssl rand -base64 32 | tr -d '\n'   -> DD_CREDENTIAL_AES_256_KEY
DD_SECRET_KEY=CHANGE_ME_LONG_RANDOM_STRING
DD_CREDENTIAL_AES_256_KEY=CHANGE_ME_32_BYTE_KEY

# --- baza danych (postgres) ---
DD_DATABASE_ENGINE=django.db.backends.postgresql
DD_DATABASE_HOST=postgres
DD_DATABASE_PORT=5432
DD_DATABASE_NAME=defectdojo
DD_DATABASE_USER=defectdojo
DD_DATABASE_PASSWORD=defectdojo

# --- celery / redis ---
DD_CELERY_BROKER_SCHEME=redis
DD_CELERY_BROKER_HOST=redis
DD_CELERY_BROKER_PORT=6379
DD_CELERY_BROKER_PATH=/0
DD_CELERY_BROKER_PARAMS=
DD_CELERY_LOG_LEVEL=INFO
DD_CELERY_WORKER_POOL_TYPE=solo

# --- admin wygenerowany przy pierwszym starcie (initializer) ---
DD_ADMIN_USER=admin
DD_ADMIN_MAIL=admin@example.com
DD_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
DD_ADMIN_FIRST_NAME=Admin
DD_ADMIN_LAST_NAME=HackNation

# --- uzupelnic PO pierwszym logowaniu do UI (Configuration > API key), potrzebne do importu wynikow ---
DD_API_KEY=
DD_ENGAGEMENT_ID=
