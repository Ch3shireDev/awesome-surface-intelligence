# Skopiuj do .env (gitignored). `make env` robi to za ciebie i generuje sekrety.

# --- wersje / porty ---
DD_VERSION=3.5.202
# port UI/API DefectDojo na VM (to jego forwardujesz z hosta)
DD_PORT=8080

# --- DefectDojo core ---
DD_DEBUG=False
DD_DJANGO_METRICS_ENABLED=False
DD_ALLOWED_HOSTS=*
DD_SITE_URL=http://localhost:8080
# originy, z ktorych otwierasz UI w przegladarce (lista po przecinku)
DD_CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# make env generuje (openssl rand -hex 32 / -hex 16)
DD_SECRET_KEY=CHANGE_ME
DD_CREDENTIAL_AES_256_KEY=CHANGE_ME

# --- baza danych (postgres) ---
DD_DATABASE_NAME=defectdojo
DD_DATABASE_USER=defectdojo
DD_DATABASE_PASSWORD=defectdojo
DD_DATABASE_HOST=postgres
DD_DATABASE_PORT=5432
DD_DATABASE_URL=postgresql://defectdojo:defectdojo@postgres:5432/defectdojo

# --- celery broker + cache (valkey) ---
DD_CELERY_BROKER_URL=redis://valkey:6379/0
DD_CACHE_URL=redis://valkey:6379/1

# --- admin tworzony przy pierwszym starcie (initializer) ---
DD_ADMIN_USER=admin
DD_ADMIN_MAIL=admin@example.com
DD_ADMIN_PASSWORD=CHANGE_ME
DD_ADMIN_FIRST_NAME=Admin
DD_ADMIN_LAST_NAME=HackNation

# --- import wynikow ---
# Opcjonalne: jak puste, `make import-defectdojo` pobiera token API logujac
# sie DD_ADMIN_USER/DD_ADMIN_PASSWORD.
DD_API_KEY=
# Product/Engagement tworza sie same przy imporcie (auto_create_context).
DD_PRODUCT_TYPE=HackNation
DD_PRODUCT="Attack Surface"
DD_ENGAGEMENT=nmap

# --- szyfrowanie danych w spoczynku (SEC-6, docs/guide/encryption.md) ---
# Nakladka z TDE dla asi-db (pg_tde); compose czyta COMPOSE_FILE z .env.
COMPOSE_FILE=docker-compose.yml:docker-compose.crypto.yml
# Klucze AES-256-GCM dla pol wrazliwych: id:base64(32 bajty), lista po przecinku,
# PIERWSZY szyfruje, wszystkie odszyfrowuja (rotacja). make env / make env-keys generuje.
ASI_ENCRYPTION_KEYS=

# --- baza ASI (asi-db, osobna od DefectDojo) ---
# make env generuje haslo; port tylko na 127.0.0.1
ASI_DB_PASSWORD=CHANGE_ME_ASI_DB
ASI_DB_PORT=5433
ASI_DATABASE_URL=postgres://asi:CHANGE_ME_ASI_DB@127.0.0.1:5433/asi

# --- panel web ASI (asi server) ---
# pierwszy admin tworzony przy starcie, gdy w bazie nie ma uzytkownikow; make env generuje haslo
ASI_ADMIN_USER=admin
ASI_ADMIN_PASSWORD=CHANGE_ME_ASI_ADMIN
ASI_WEB_ADDR=127.0.0.1:8090
ASI_LIVE_ADDR=127.0.0.1:8091

# --- bezpieczenstwo skanera (SEC-8, docs/guide/safety.md) ---
# twarde limity operatora: flagi CLI i GUI nie moga ich podniesc
ASI_MAX_RATE=1000
ASI_MAX_PARALLEL=32
# raw (NET_RAW: -sS, ICMP) | unprivileged (tylko -sT; z docker-compose.unprivileged.yml)
ASI_SCAN_PROFILE=raw
# dozwolone porty TCP, puste = wszystkie, np. 1-1024,3389,8000-8999
ASI_ALLOWED_PORTS=
# zakres i wykluczenia (oprocz plikow targets/scope.txt i targets/exclude.txt), po przecinku
ASI_SCOPE=
ASI_EXCLUDE=
# UDP wylaczone; 1 = -sU tylko na ASI_UDP_PORTS
ASI_ALLOW_UDP=
ASI_UDP_PORTS=53,123,161

# --- cele z dowolnego tekstu (DEV-8: panel "Wklej dowolny tekst", asi targets-extract, asi mcp) ---
# klucz DeepSeek (https://platform.deepseek.com); puste = tylko proste wyszukiwanie adresow (regex)
# Uwaga: wklejony tekst trafia do API DeepSeek. Dla danych, ktorych nie chcesz wysylac, wybierz silnik "regex".
DEEPSEEK_API_KEY=
# opcjonalnie inny dostawca zgodny z OpenAI (np. OpenRouter): ASI_LLM_BASE_URL, ASI_LLM_API_KEY
ASI_LLM_MODEL=deepseek-flash
ASI_LLM_BASE_URL=https://api.deepseek.com
